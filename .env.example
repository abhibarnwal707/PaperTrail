# Copy to .env (git-ignored). Never commit real values.

# --- agent LLMs (existing) ---
LLM_API_KEY=            # Groq
OPENROUTER_API_KEY=     # OpenRouter free-model failover

# --- model lifecycle (defaults shown; all optional) ---
# MLFLOW_TRACKING_URI=sqlite:///data/local/mlflow.db   # or the DagsHub MLflow URI
# PAPERTRAIL_REGISTERED_MODEL=papertrail-xgb
# PAPERTRAIL_EXPERIMENT=papertrail-lifecycle
# GATE_TOL_PR_AUC=0.01            # how much worse than production a candidate may be (absolute)
# GATE_TOL_RECALL_1FPR=0.02
# PAPERTRAIL_MODEL_DIR=data/local/production_model     # API: serve the exported registry model (falls back to data/demo/model)

# --- agent tracing (off by default; the demo is unchanged unless set) ---
# PAPERTRAIL_TRACING=jsonl                  # off | jsonl
# PAPERTRAIL_TRACE_DIR=data/local/traces
